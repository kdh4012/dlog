# docker compose 운영 실행용 환경 변수. 복사 후 값 변경: cp .env.example .env
DB_PASSWORD=change-me
# 32자 이상 랜덤 문자열 (예: openssl rand -base64 48)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_USERNAME=admin
# cd backend && ./gradlew -q hashPassword -Ppw=비밀번호
# docker compose 는 '$' 를 변수로 해석하므로 해시의 '$' 를 '$$' 로 바꿔서 입력
ADMIN_PASSWORD_HASH=
# 자산 동기화 (선택, 비우면 미사용). 서버 공인 IP 를 각 서비스의 허용 IP 로 등록해야 함
# 업비트: 마이페이지 > Open API 관리 > '자산조회' 권한만 체크
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
# 토스증권: WTS > 설정 > Open API
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
